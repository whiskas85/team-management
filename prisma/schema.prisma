generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- ruoli e stati

/// Un operatore può avere più ruoli contemporaneamente (es. ATLETA + TL).
enum Role {
  ADMIN // gestisce tutto
  AMMINISTRAZIONE // iscrizioni, certificati medici, tessere FIGT
  SEGRETERIA // pagamenti e quote
  TL // team leader: schiera titolari e riserve negli eventi
  MODERATORE // tiene pulite le conversazioni: legge le segnalazioni e cancella
  ATLETA // membro effettivo della squadra
}

/// Percorso di un operatore, dal primo contatto all'ingresso in squadra.
enum StatoOperatore {
  NUOVO // si sta approcciando al team, viene alle open
  ATTESA_COMPILAZIONE // ha ricevuto l'invito di iscrizione, deve compilare
  ATTESA_ACCETTAZIONE // ha inviato il modulo, attende la valutazione
  SQUADRA // membro effettivo
  DA_RICONFERMARE // era in squadra: aperta la nuova stagione attende il reinvito
  RIFIUTATO // valutazione negativa: si conserva lo storico
  SOSPESO // in squadra ma temporaneamente fuori
  DISABILITATO // non accede più
}

enum CertStatus {
  IN_ATTESA
  VALIDO
  SCADUTO
  RIFIUTATO
}

enum CertType {
  NON_AGONISTICO
  AGONISTICO
}

/// A chi è rilasciata l'attività. Si decide al momento del rilascio.
enum EventVisibility {
  TEAM // solo la squadra
  TUTTI // aperta anche ai nuovi
}

enum EventStatus {
  CREATA // bozza: la vede solo chi gestisce il calendario
  RILASCIATA // pubblicata secondo la visibilità scelta
  CONCLUSA
  ANNULLATA
}

enum RsvpStatus {
  PRESENTE
  ASSENTE
  FORSE
}

/// Schieramento deciso dal TL a partire dalle adesioni.
enum Assegnazione {
  NON_ASSEGNATO
  /// Chiamato in formazione ma la quota non è ancora saldata: il posto è suo
  /// finché non paga, e diventa titolare nel momento in cui l'incasso è
  /// registrato. Su un'attività gratuita questo stato non esiste.
  CONVOCATO
  TITOLARE
  /// Sala controllo: c'è, ma non in campo. Non occupa un posto della
  /// formazione e non paga la quota, perché la quota paga il campo.
  TOC
  RISERVA
}

enum FieldType {
  BOSCHIVO
  URBANO
  CQB
  INDOOR
  MISTO
}

/// Tipo di richiesta inviata dall'amministrazione: determina la quota.
enum TipoIscrizione {
  ISCRIZIONE // primo tesseramento
  REISCRIZIONE // rinnovo di chi c'era già l'anno prima
}

enum MembershipStatus {
  INVITATA // l'amministrazione ha inoltrato la richiesta
  COMPILATA // l'operatore ha inviato il modulo, attende accettazione
  ATTIVA // approvata
  RIFIUTATA // respinta, resta a storico
  SCADUTA
}

enum FigtStatus {
  DA_RECUPERARE // codice ancora da prendere dal portale
  ATTIVA
  SCADUTA
  REVOCATA
}

enum PaymentType {
  ISCRIZIONE
  TESSERA_FIGT
  TORNEO
  GARA
  ALLENAMENTO
  EVENTO
  MERCHANDISING // ordine dal catalogo del team: i soldi vanno in cassa
  RIMBORSO // somma da restituire, tenuta separata dagli incassi
  ALTRO
}

enum PaymentStatus {
  DA_PAGARE
  PARZIALE
  PAGATO
  ANNULLATO
}

// ---------------------------------------------------------------- operatori

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  passwordHash         String
  nome                 String
  cognome              String
  callsign             String?
  /// Password generata dall'admin: finche' e' vero l'operatore non va da
  /// nessuna parte se non a cambiarla. Serve perche' non si mandano email:
  /// la password viaggia a voce, e a voce non deve restare.
  deveCambiarePassword Boolean        @default(false)
  /// Una riga scelta dall'operatore, sotto al nome: motto, ruolo in squadra,
  /// quello che vuole. Serve solo a farsi riconoscere, non a nient'altro.
  frase                String?
  telefono             String?
  dataNascita          DateTime?
  luogoNascita         String?
  codiceFiscale        String?
  indirizzo            String?
  citta                String?
  cap                  String?
  provincia            String?
  emergenzaNome        String?
  emergenzaTel         String?
  gruppoSanguigno      String?
  allergie             String? // allergie e note mediche, su più righe
  /// Foto del profilo: percorso relativo dentro UPLOAD_DIR.
  fotoPath             String?
  roles                Role[]         @default([])
  stato                StatoOperatore @default(NUOVO)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  disabledAt           DateTime?
  ultimoAccesso        DateTime?
  /// L'ultima volta che questa persona ha **usato** il gestionale, non che ci
  /// è entrata.
  ///
  /// Sono due cose diverse e la seconda dice poco: chi ha spuntato «ricordami»
  /// non accede più per due mesi pur aprendo l'applicazione tutti i giorni, e
  /// dalla sua scheda sembrava sparito. Questa data si aggiorna mentre si
  /// naviga, non al momento di entrare.
  ultimaAttivita       DateTime?
  /// Account admin creato dall'avvio per non restare chiusi fuori da
  /// un'installazione nuova. Se ne compare uno vero, questo se ne va da solo.
  /// Marcarlo è l'unico modo per riconoscerlo con certezza: l'email da sola
  /// no, perché potrebbe essere quella di una persona vera.
  creatoDalSeed        Boolean        @default(false)

  // --- GDPR: consensi raccolti e tracciati con data e versione dell'informativa
  privacyAccettataIl   DateTime?
  privacyVersione      String?
  consensoImmagini     Boolean   @default(false)
  consensoImmaginiIl   DateTime?
  consensoComunicaz    Boolean   @default(false)
  consensoComunicazIl  DateTime?
  cancellazioneChiesta DateTime?

  certificates          MedicalCertificate[]    @relation("CertOwner")
  reviewedCerts         MedicalCertificate[]    @relation("CertReviewer")
  rsvps                 EventRsvp[]
  payments              Payment[]               @relation("PaymentUser")
  recordedPays          Payment[]               @relation("PaymentRecorder")
  memberships           Membership[]            @relation("MembershipUser")
  invitiInviati         Membership[]            @relation("MembershipInviter")
  decisiMships          Membership[]            @relation("MembershipDecider")
  figtCards             FigtCard[]
  whatsapp              CollegamentoWhatsapp[]  @relation("WhatsappDi")
  messaggi              MessaggioInviato[]      @relation("MessaggiRicevuti")
  tesseramentiImportati TesseramentoImportato[] @relation("TesseramentoImportato")
  giornaliere           TesseraGiornaliera[]    @relation("GiornaliereUtente")
  eventiLetti           LetturaEvento[]         @relation("LettoreEvento")
  letturaDaAltri        LetturaProfilo[]        @relation("ProfiloLetto")
  profiliLetti          LetturaProfilo[]        @relation("Lettore")
  noteScritte           Nota[]                  @relation("NoteScritte")
  noteSuDiMe            Nota[]                  @relation("NoteSuDiMe")
  citatoInNote          NotaCitazione[]         @relation("CitatoInNote")
  commenti              CommentoEvento[]        @relation("CommentiScritti")
  miPiace               MiPiaceEvento[]         @relation("MiPiaceMessi")
  commentiAnnunci       CommentoAnnuncio[]      @relation("CommentiAnnunci")
  miPiaceAnnunci        MiPiaceAnnuncio[]       @relation("MiPiaceAnnunci")
  eventsCreated         Event[]                 @relation("EventCreator")
  debriefing            Debriefing[]            @relation("DebriefingScritti")
  debriefingLetti       LetturaDebriefing[]     @relation("LettoreDebriefing")
  movimentiCassa        MovimentoCassa[]        @relation("CassaRegistrante")
  tokenMcp              TokenMcp[]              @relation("TokenMcpDi")
  documenti             Documento[]             @relation("DocumentiScritti")
  annunci               Annuncio[]              @relation("AnnunciDi")
  vociPrenotate         VoceAnnuncio[]          @relation("VociPrenotate")
  ordini                Ordine[]                @relation("OrdiniDi")
  carrello              RigaCarrello[]          @relation("CarrelloDi")
  carichi               CaricoMagazzino[]       @relation("CarichiRegistrati")
  documentiAccettati    AccettazioneDocumento[] @relation("DocumentiAccettati")
  riordini              Riordino[]              @relation("RiordiniCreati")
  segnalazioniFatte     Segnalazione[]          @relation("SegnalazioniFatte")
  segnalazioniGestite   Segnalazione[]          @relation("SegnalazioniGestite")
  preferiti             Preferito[]             @relation("PreferitiDi")
  erroriIncontrati      ErroreClient[]          @relation("ErroriIncontrati")

  @@index([stato])
}

// ---------------------------------------------------------------- certificati medici

model MedicalCertificate {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation("CertOwner", fields: [userId], references: [id], onDelete: Cascade)
  tipo          CertType   @default(NON_AGONISTICO)
  status        CertStatus @default(IN_ATTESA)
  rilasciatoIl  DateTime?
  scadeIl       DateTime?
  fileName      String
  filePath      String
  mimeType      String
  fileSize      Int
  note          String?
  motivoRifiuto String?
  reviewedById  String?
  reviewedBy    User?      @relation("CertReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  createdAt     DateTime   @default(now())

  @@index([userId, status])
  @@index([scadeIl])
}

// ---------------------------------------------------------------- squadre esterne

/// Altri team: gestiscono campi, organizzano eventi, ci si gioca insieme.
model SquadraEsterna {
  id        String   @id @default(cuid())
  nome      String   @unique
  referente String?
  telefono  String?
  email     String?
  sito      String?
  citta     String?
  provincia String?
  note      String?
  attiva    Boolean  @default(true)
  createdAt DateTime @default(now())

  campi Field[]

  @@index([attiva, nome])
}

// ---------------------------------------------------------------- campi da gioco

model Field {
  id        String    @id @default(cuid())
  nome      String
  tipo      FieldType @default(BOSCHIVO)
  indirizzo String?
  citta     String?
  provincia String?
  lat       Float?
  lng       Float?
  referente String?
  telefono  String?
  sito      String?
  costo     Decimal?  @db.Decimal(10, 2)
  note      String?
  attivo    Boolean   @default(true)
  createdAt DateTime  @default(now())

  /// Squadra che lo gestisce, quando il campo non è nostro.
  squadraId String?
  squadra   SquadraEsterna? @relation(fields: [squadraId], references: [id], onDelete: SetNull)

  events Event[]

  @@index([squadraId])
}

// ---------------------------------------------------------------- anagrafiche di base

/// Tipologie di attività, gestite dall'admin nei dati di base.
/// Chi ha gia' aperto la scheda di chi. Serve al pallino sui "Nuovi": una
/// registrazione resta segnalata finche' non la si e' andata a leggere, e
/// vale per lettore, non per tutti: se la apre un admin, l'altro deve
/// comunque vederla segnalata.
/// Chi ha già aperto quale attività.
///
/// Serve al pallino delle novità: un'attività appena rilasciata è nuova **per
/// chi non l'ha ancora aperta**, non in assoluto. La lettura è quindi per
/// persona — se la apre il team leader, agli altri resta segnalata.
///
/// La riga nasce solo quando qualcuno apre: l'assenza vuol dire "non letta",
/// che è lo stato di partenza di tutti e non va scritto da nessuna parte.
model LetturaEvento {
  eventId String
  evento  Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  utente  User     @relation("LettoreEvento", fields: [userId], references: [id], onDelete: Cascade)
  lettoIl DateTime @default(now())

  @@id([eventId, userId])
  @@index([userId])
}

model LetturaProfilo {
  id        String   @id @default(cuid())
  profiloId String
  profilo   User     @relation("ProfiloLetto", fields: [profiloId], references: [id], onDelete: Cascade)
  lettoreId String
  lettore   User     @relation("Lettore", fields: [lettoreId], references: [id], onDelete: Cascade)
  lettoIl   DateTime @default(now())

  @@unique([profiloId, lettoreId])
  @@index([lettoreId])
}

/// Credenziali del portale federale ASNWG/FIGT, salvate da un admin.
/// La password serve in chiaro per fare il login sul portale, quindi non si
/// puo' usare un hash: viene cifrata con AES-GCM e la chiave sta nell'ambiente.
/// Riga unica: il collegamento e' uno solo per tutta l'associazione.
model CredenzialeFigt {
  id               String    @id @default("figt")
  login            String
  /// Password cifrata: iv, tag e testo cifrato in un'unica stringa.
  passwordCifrata  String
  idAnagrafica     String
  /// Id affiliazione: serve alle polizze prova, ed e' un numero diverso
  /// dall'id anagrafica usato per i tesseramenti annuali.
  idAffiliazione   String?
  salvataDa        String?
  salvataIl        DateTime  @default(now())
  ultimoAccesso    DateTime?
  ultimoEsito      String?
  /// Polizze prova prepagate ancora da usare, come le conta il portale.
  /// Sono soldi già spesi: la cassa le mostra insieme al saldo.
  polizzeResidue   Int?
  polizzeAssegnate Int?
  polizzeLetteIl   DateTime?
}

/// Stato della copertura assicurativa per una singola partecipazione.
enum StatoAssicurazione {
  NON_ASSICURATO // serve la giornaliera e non e' ancora stata emessa
  RICHIESTA // richiesta partita verso il portale, si aspetta risposta
  ASSICURATO // giornaliera emessa: c'e' il codice
  ERRORE // il portale ha rifiutato: si riprova o si fa a mano
}

/// Tessera giornaliera FIGT: la copertura di chi viene a giocare senza avere
/// la tessera annuale. Vale per quella singola attivita' e per quel giorno,
/// quindi vive attaccata alla coppia persona + attivita'.
///
/// Come la tessera annuale, non la emettiamo noi: il numero arriva dal portale
/// federale. Qui si tiene traccia di dove sta la pratica.
model TesseraGiornaliera {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation("GiornaliereUtente", fields: [userId], references: [id], onDelete: Cascade)
  eventId          String
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stato            StatoAssicurazione @default(NON_ASSICURATO)
  /// Numero della polizza prova restituito dal portale.
  codice           String?
  /// Numero della polizza infortuni della compagnia (AIG), come lo scrive il portale.
  polizzaInfortuni String?
  /// Fino a quando copre: la polizza vale fino alle 24:00 del giorno della prova.
  valeIl           DateTime?
  /// Id della pratica sul portale, per risalire alla scheda.
  idPortale        String?
  richiestaIl      DateTime?
  emessaIl         DateTime?
  /// Esito dell'ultimo tentativo, per capire cosa e' andato storto.
  esito            String?
  /// Chi ha fatto partire la richiesta.
  richiestaDaId    String?
  createdAt        DateTime           @default(now())

  @@unique([userId, eventId])
  @@index([eventId])
}

/// Quello che il portale federale ha restituito, riga per riga. Si conserva
/// per poter associare a mano i tesseramenti che l'abbinamento automatico non
/// ha saputo attribuire, senza dover interrogare di nuovo il portale.
model TesseramentoImportato {
  id          String   @id @default(cuid())
  numero      String   @unique
  nominativo  String
  email       String?
  comune      String?
  qualifica   String?
  stato       String
  tesseraAcsi String?
  anno        Int
  idPortale   String?
  /// Operatore a cui e' stata attribuita, quando ci si e' riusciti.
  userId      String?
  user        User?    @relation("TesseramentoImportato", fields: [userId], references: [id], onDelete: SetNull)
  lettoIl     DateTime @default(now())

  @@index([anno])
  @@index([userId])
}

/// Anagrafica delle stagioni sportive. Iscrizioni, tessere e attività vivono
/// dentro una stagione: aprirne una nuova azzera la rosa, che si ricompone
/// reinvitando gli operatori uno a uno.
model Stagione {
  id        String   @id @default(cuid())
  nome      String   @unique // "2026/2027"
  inizio    DateTime
  fine      DateTime
  /// La stagione in corso: una sola, è quella che il gestionale propone ovunque.
  corrente  Boolean  @default(false)
  chiusa    Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())

  memberships Membership[]
  figtCards   FigtCard[]
  eventi      Event[]
  tariffe     Tariffa[]

  @@index([corrente])
}

/// A cosa serve una tariffa dentro il gestionale. E' facoltativa: serve solo
/// quando l'importo deve essere pescato da solo in qualche automatismo.
enum VoceTariffa {
  ISCRIZIONE // proposta come quota nelle richieste di primo tesseramento
  REISCRIZIONE // proposta come quota nei rinnovi
  TESSERA_FIGT // proposta quando si registra una tessera federale
  GIOCATA_NUOVO // giocata degli esterni: arriva gia' spuntata creando un'attivita'
  AFFITTO // noleggio attrezzatura
  ATTIVITA // compare fra le voci con cui si compongono le quote di un'attivita'
}

/// Listino: quanto costa una cosa. Il nome e' libero, cosi' in una stagione
/// possono convivere "Reiscrizione" e "Cassa comune".
///
/// Gli usi sono un insieme, non uno solo: un rinnovo puo' essere fatto di piu'
/// voci (lo spaccato della quota) e la stessa voce puo' valere sia per
/// l'iscrizione sia per la reiscrizione. Un automatismo propone la somma di
/// tutte le voci che lo dichiarano.
///
/// La stagione e' facoltativa: senza, l'importo vale sempre; con la stagione
/// vale solo per quella e ha la precedenza.
model Tariffa {
  id         String        @id @default(cuid())
  nome       String
  usi        VoceTariffa[]
  stagioneId String?
  stagione   Stagione?     @relation(fields: [stagioneId], references: [id], onDelete: Cascade)
  importo    Decimal       @db.Decimal(10, 2)
  note       String?
  attiva     Boolean       @default(true)
  createdAt  DateTime      @default(now())

  @@index([nome])
}

model TipoAttivita {
  id             String      @id @default(cuid())
  nome           String      @unique
  descrizione    String?
  colore         String      @default("verde") // tinta usata nel calendario
  /// Categoria con cui nascono le quote generate da questa tipologia.
  tipoQuota      PaymentType @default(EVENTO)
  /// Solo per le tipologie a formazione (gare, tornei): il TL schiera titolari
  /// e riserve. Per allenamenti e simili non ha senso e non viene mostrato.
  riserve        Boolean     @default(false)
  /// Attività riservata alla squadra: non può essere rilasciata a tutti.
  soloInterno    Boolean     @default(false)
  /// Serve il certificato medico per partecipare. Spento dove non si gioca —
  /// una riunione, una cena sociale — così chi non ce l'ha può segnarsi lo stesso.
  certMedico     Boolean     @default(true)
  /// Richiede il certificato AGONISTICO: con il solo non agonistico non si entra.
  certAgonistico Boolean     @default(false)
  /// È una riunione: si fa in una sala o in videochiamata, non in campo. Le
  /// tipologie con questo segno sono quelle che si possono creare al volo da
  /// un'attività, e su di esse spariscono ritrovo, posti e quote — cose che a
  /// una riunione non servono e riempiono solo il modulo.
  riunione       Boolean     @default(false)
  ordine         Int         @default(0)
  attivo         Boolean     @default(true)
  createdAt      DateTime    @default(now())

  events Event[]

  @@index([attivo, ordine])
}

/// Che gara è: 24 ore, scenario, speedsoft, torneo a squadre.
///
/// È un'anagrafica a parte dalla tipologia di attività, e non un doppione: la
/// tipologia dice **come il gestionale tratta** quella giornata — se schiera
/// titolari, se chiede il certificato, in che categoria finisce la quota. Il
/// tipo di gara dice **che gara è**, che riguarda chi gioca e non il
/// gestionale: due 24 ore possono avere la stessa tipologia e non somigliarsi
/// per niente.
///
/// Sta in tabella e non in un elenco scritto nel codice perché i formati li
/// inventano gli organizzatori, non noi: ne esce uno nuovo ogni stagione, e
/// aggiungerlo non deve voler dire fare un rilascio.
model TipoGara {
  id          String   @id @default(cuid())
  nome        String   @unique
  descrizione String?
  ordine      Int      @default(0)
  attivo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  eventi Event[]

  @@index([attivo, ordine])
}

/// Modalità con cui si incassa una quota, gestite nei dati di base.
model MetodoPagamento {
  id          String   @id @default(cuid())
  nome        String   @unique
  descrizione String?
  /// Indicazioni per chi paga: IBAN, numero Satispay, e simili.
  istruzioni  String?
  /// Se vero l'operatore può dichiararlo da sé quando salda.
  selfService Boolean  @default(false)
  ordine      Int      @default(0)
  attivo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  payments  Payment[]
  movimenti MovimentoCassa[]

  @@index([attivo, ordine])
}

// ---------------------------------------------------------------- eventi

model Event {
  id                    String           @id @default(cuid())
  titolo                String
  descrizione           String?
  tipoId                String?
  tipo                  TipoAttivita?    @relation(fields: [tipoId], references: [id])
  stagioneId            String?
  stagione              Stagione?        @relation(fields: [stagioneId], references: [id])
  /// Che gara è, dall'anagrafica dei tipi di gara. Vuoto su tutto ciò che una
  /// gara non è: un allenamento, una riunione, una cena.
  tipoGaraId            String?
  tipoGara              TipoGara?        @relation(fields: [tipoGaraId], references: [id], onDelete: SetNull)
  /// La durata dichiarata dall'organizzatore, in ore: la **24h** del volantino.
  ///
  /// **Non si confronta con inizio e fine, ed è voluto.** Una 24 ore si gioca
  /// dentro un fine settimana che comincia il venerdì e finisce la domenica:
  /// l'attività tiene occupato tutto quello spazio — si parte, si monta, si
  /// dorme, si smonta — mentre la gara dura quello che dice il volantino. Sono
  /// due fatti diversi e nessuno dei due è sbagliato. Un controllo che
  /// pretendesse di farli coincidere costringerebbe a scrivere una data falsa
  /// per far tacere un avviso, ed è il modo migliore per rendere inaffidabile
  /// il calendario.
  durataOre             Int?
  visibilita            EventVisibility? // obbligatoria solo al rilascio
  status                EventStatus      @default(CREATA)
  inizio                DateTime
  fine                  DateTime?
  /// Dove ci si trova prima di partire: il testo che si legge, e le coordinate
  /// per il pulsante "Naviga". Un ritrovo scritto a mano — "autogrill A4" —
  /// non porta nessuno da nessuna parte.
  ritrovo               String?
  ritrovoLat            Float?
  ritrovoLng            Float?
  oraRitrovo            DateTime?
  fieldId               String?
  field                 Field?           @relation(fields: [fieldId], references: [id])
  /// Il posto quando non è un campo dell'elenco: una fiera, un parcheggio, la
  /// sede di un'altra squadra. Non tutto quello che si fa insieme succede su un
  /// campo censito, e costringere a inventarne uno sporcherebbe l'anagrafica.
  luogo                 String?
  luogoLat              Float?
  luogoLng              Float?
  /// Il collegamento per chi partecipa da lontano. Ha senso solo su una
  /// riunione: a una partita non ci si connette.
  linkRiunione          String?
  /// Quota di chi è in squadra. Nulla = attività gratuita per loro; si compone
  /// dalle voci di listino come le iscrizioni, e `dettaglio` racconta di cosa
  /// è fatta ("Contributo campo 5,00 €").
  costo                 Decimal?         @db.Decimal(10, 2)
  dettaglioCosto        String?
  /// Quota di chi in squadra non è (i "nuovi" che vengono alle aperte).
  /// Nulla = pagano come la squadra; zero = la giocata è offerta.
  costoEsterni          Decimal?         @db.Decimal(10, 2)
  dettaglioCostoEsterni String?
  maxPartecipanti       Int?
  chiusuraIscrizioni    DateTime?
  note                  String?
  createdById           String?
  createdBy             User?            @relation("EventCreator", fields: [createdById], references: [id])
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  rsvps       EventRsvp[]
  payments    Payment[]
  giornaliere TesseraGiornaliera[]
  messaggi    MessaggioInviato[]
  letture     LetturaEvento[]
  noteInterne Nota[]
  commenti    CommentoEvento[]
  miPiace     MiPiaceEvento[]
  debriefing  Debriefing?

  @@index([inizio])
}

model EventRsvp {
  id           String       @id @default(cuid())
  eventId      String
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       RsvpStatus
  assegnazione Assegnazione @default(NON_ASSEGNATO)
  /// Subentra al posto di qualcuno che aveva già pagato: il club la somma
  /// l'ha incassata, e chiederla due volte per lo stesso posto sarebbe
  /// incassarla due volte.
  esenteQuota  Boolean      @default(false)
  presente     Boolean? // presenza effettiva, registrata a evento concluso
  note         String?
  respondedAt  DateTime     @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------- iscrizioni

model Membership {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  stagioneId     String
  stagione       Stagione         @relation(fields: [stagioneId], references: [id], onDelete: Cascade)
  tipo           TipoIscrizione   @default(ISCRIZIONE)
  status         MembershipStatus @default(INVITATA)
  quota          Decimal?         @db.Decimal(10, 2)
  /// Di cosa è fatta la quota, quando nasce da più voci di listino:
  /// "Reiscrizione 50 € + Cassa comune 25 €". Serve a chi la riceve per capire
  /// cosa sta pagando, e a noi per ricostruirlo a distanza di un anno.
  dettaglioQuota String?
  messaggio      String? // testo dell'invito
  compilato      String? // note lasciate dall'operatore in fase di compilazione
  note           String? // esito / motivo del rifiuto
  invitataIl     DateTime         @default(now())
  invitedById    String?
  invitedBy      User?            @relation("MembershipInviter", fields: [invitedById], references: [id])
  compilataIl    DateTime?
  decisaIl       DateTime?
  decidedById    String?
  decidedBy      User?            @relation("MembershipDecider", fields: [decidedById], references: [id])
  scadeIl        DateTime?

  payments Payment[]

  @@unique([userId, stagioneId])
  @@index([status])
}

// ---------------------------------------------------------------- tessere FIGT

model FigtCard {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codice       String? // n° tessera FIGT recuperato dal portale ASNWG, es. "2026-02885"
  /// Anno di tesseramento federale: la tessera vale fino al 31 dicembre di quell'anno.
  anno         Int?
  /// Id del tesseramento sul portale, per risalire alla scheda originale.
  idPortale    String?
  /// Nominativo come lo scrive il portale: serve a rivedere gli abbinamenti.
  nominativo   String?
  stagioneId   String
  stagione     Stagione   @relation(fields: [stagioneId], references: [id], onDelete: Cascade)
  status       FigtStatus @default(DA_RECUPERARE)
  scadeIl      DateTime?
  verificatoIl DateTime?
  note         String?
  createdAt    DateTime   @default(now())

  payments Payment[]

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------- pagamenti

model Payment {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation("PaymentUser", fields: [userId], references: [id], onDelete: Cascade)
  tipo         PaymentType
  descrizione  String
  importo      Decimal          @db.Decimal(10, 2)
  pagato       Decimal          @default(0) @db.Decimal(10, 2)
  status       PaymentStatus    @default(DA_PAGARE)
  metodoId     String?
  metodo       MetodoPagamento? @relation(fields: [metodoId], references: [id])
  scadenza     DateTime?
  pagatoIl     DateTime?
  /// Quando l'operatore ha dichiarato di aver pagato: resta da confermare.
  dichiaratoIl DateTime?
  note         String?
  eventId      String?
  event        Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  membershipId String?
  membership   Membership?      @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  figtCardId   String?
  figtCard     FigtCard?        @relation(fields: [figtCardId], references: [id], onDelete: SetNull)
  recordedById String?
  recordedBy   User?            @relation("PaymentRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  /// Ordine del merchandising da cui nasce questa quota, se ne viene.
  ordine Ordine?

  /// Quota di cui questo movimento è il rimborso.
  rimborsoDiId String?  @unique
  rimborsoDi   Payment? @relation("Rimborso", fields: [rimborsoDiId], references: [id], onDelete: Cascade)
  rimborso     Payment? @relation("Rimborso")

  @@index([userId, status])
  @@index([status])
}

// ---------------------------------------------------------------- cassa

enum TipoMovimento {
  ENTRATA
  USCITA
}

/// Movimenti di cassa inseriti a mano: quello che non nasce dalle attività.
model MovimentoCassa {
  id             String           @id @default(cuid())
  tipo           TipoMovimento
  descrizione    String
  importo        Decimal          @db.Decimal(10, 2)
  data           DateTime         @default(now())
  categoria      String?
  note           String?
  metodoId       String?
  metodo         MetodoPagamento? @relation(fields: [metodoId], references: [id])
  registratoById String?
  registratoBy   User?            @relation("CassaRegistrante", fields: [registratoById], references: [id])
  createdAt      DateTime         @default(now())

  /// Il riordino che ha generato questa uscita, se ne viene.
  riordino Riordino?
  /// La merce entrata in magazzino con questa uscita, se la spesa era un
  /// acquisto: si compra, si scrive quanto è costata, e la giacenza sale da
  /// sola invece di dover ricopiare gli stessi numeri in due posti.
  carico   CaricoMagazzino?

  @@index([data])
}

// ---------------------------------------------------------------- note interne

/// Nota privata di chi ha un incarico: su una persona, su un'attività, o su
/// entrambe.
///
/// **La legge solo chi l'ha scritta.** Non è un dettaglio tecnico ma il patto
/// che la rende utile: una nota su una lite o su un comportamento la si scrive
/// com'è andata solo se non finisce sotto gli occhi di altri — nemmeno di un
/// admin. Chi vuole condividere un'osservazione ha la chat della squadra.
model Nota {
  id        String          @id @default(cuid())
  autoreId  String
  autore    User            @relation("NoteScritte", fields: [autoreId], references: [id], onDelete: Cascade)
  titolo    String
  /// Markdown, come statuto e regolamento.
  testo     String
  /// La persona a cui la nota è appuntata, se ce n'è una.
  userId    String?
  persona   User?           @relation("NoteSuDiMe", fields: [userId], references: [id], onDelete: Cascade)
  /// L'attività a cui la nota è appuntata, se ce n'è una.
  eventId   String?
  evento    Event?          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  citate    NotaCitazione[]

  @@index([autoreId])
  @@index([userId])
  @@index([eventId])
}

/// Chi è citato con la chiocciola dentro una nota.
///
/// È un indice ricavato dal testo, non una seconda verità: si ricalcola a ogni
/// salvataggio. Serve a una cosa sola — far comparire sulla scheda di una
/// persona anche le note scritte altrove che la nominano.
model NotaCitazione {
  notaId String
  nota   Nota   @relation(fields: [notaId], references: [id], onDelete: Cascade)
  userId String
  utente User   @relation("CitatoInNote", fields: [userId], references: [id], onDelete: Cascade)

  @@id([notaId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------- commenti e mi piace

/// Commento a un'attività, visibile a chiunque veda l'attività.
/// È l'opposto della nota: qui si parla, lì si annota.
model CommentoEvento {
  id           String    @id @default(cuid())
  eventId      String
  evento       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String
  utente       User      @relation("CommentiScritti", fields: [userId], references: [id], onDelete: Cascade)
  testo        String
  createdAt    DateTime  @default(now())
  modificatoIl DateTime?

  segnalazioni Segnalazione[]

  @@index([eventId])
}

model MiPiaceEvento {
  eventId   String
  evento    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  utente    User     @relation("MiPiaceMessi", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([eventId, userId])
}

// ---------------------------------------------------------------- messaggi

/// Collegamento a WhatsApp, uno solo per installazione.
///
/// Non c'è nessun token qui dentro: la sessione vive nel volume del ponte,
/// come le credenziali di un telefono collegato. Qui si registra soltanto **di
/// chi è** il collegamento e dove scrive di solito — perché solo chi l'ha fatto
/// possa usarlo, e un altro amministratore non lo erediti per il fatto di
/// essere admin.
model CollegamentoWhatsapp {
  id          String    @id @default("whatsapp")
  /// Numero che il ponte ha collegato, solo per mostrarlo nella pagina.
  numero      String?
  utenteId    String?
  utente      User?     @relation("WhatsappDi", fields: [utenteId], references: [id], onDelete: SetNull)
  /// Gruppo predefinito: quello che i modelli usano se non ne indicano un altro.
  gruppoId    String?
  gruppoNome  String?
  collegatoIl DateTime  @default(now())
  ultimoInvio DateTime?
  ultimoEsito String?
}

/// Cosa fa partire un messaggio.
enum ScatenanteMessaggio {
  COMPLEANNO // il giorno del compleanno
  PROMEMORIA_ATTIVITA // il giorno prima di un'attività
  QUOTA_APERTA // c'è una quota da saldare
  CERTIFICATO_IN_SCADENZA // il certificato medico sta per scadere
  LIBERO // scritto e mandato a mano
}

/// Dove finisce un messaggio: nel gruppo o nella chat della persona.
enum DoveMandare {
  GRUPPO
  PERSONA
}

/// Un messaggio che il gestionale sa mandare: **quando** dirlo e **dove**.
///
/// Qui non c'è il testo. Il testo è la cosa che si vuole moltiplicare — trenta
/// modi di fare gli auguri — mentre il gruppo su cui scrivere è la cosa che si
/// vuole cambiare in un posto solo. Tenerli sulla stessa riga significava
/// riscegliere il gruppo trenta volte, e ricambiarlo trenta volte il giorno che
/// la squadra apre una chat nuova.
model ModelloMessaggio {
  id String @id @default(cuid())
  /// Come si chiama, per ritrovarlo: "Auguri di compleanno". È anche il nome
  /// con cui un assistente lo cerca per infilarci dentro testi nuovi.
  titolo       String              @unique
  scatenante   ScatenanteMessaggio
  destinazione DoveMandare         @default(GRUPPO)
  /// Gruppo diverso da quello predefinito, quando serve.
  gruppoId  String?
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now())

  testi TestoModello[]

  @@index([scatenante, attivo])
}

/// Un modo di dire la stessa cosa.
///
/// Dentro un modello se ne scrivono quanti se ne vuole: il gestionale ruota su
/// quello usato meno di recente, così dieci compleanni di fila non sono dieci
/// volte la stessa frase. Nel testo si mettono segnaposto come {nome}.
///
/// Nasce spento quando lo propone un assistente: cinquanta frasi generate
/// contengono sempre le tre che non diresti mai, e devono passare sotto gli
/// occhi di qualcuno prima di finire nel gruppo.
model TestoModello {
  id        String           @id @default(cuid())
  modelloId String
  modello   ModelloMessaggio @relation(fields: [modelloId], references: [id], onDelete: Cascade)
  testo     String
  attivo    Boolean          @default(true)
  /// Quando è stato usato l'ultima volta: è così che si fa il giro.
  usatoIl   DateTime?
  volte     Int              @default(0)
  createdAt DateTime         @default(now())

  invii MessaggioInviato[]

  @@index([modelloId, attivo])
}

enum StatoMessaggio {
  DA_MANDARE // preparato, aspetta di partire
  INVIATO
  ERRORE
}

/// Registro di cosa è stato mandato e dove.
///
/// Serve a due cose insieme: raccontare cosa è successo, e impedire che lo
/// stesso messaggio parta due volte — il compleanno una volta l'anno, il
/// promemoria di un'attività una volta sola. È il vincolo su
/// (destinazione, occasione) a garantirlo, e regge sia per i gruppi sia per le
/// persone.
model MessaggioInviato {
  id           String              @id @default(cuid())
  /// A chi si riferisce. Vuoto per i messaggi di gruppo, che non hanno un
  /// destinatario singolo.
  userId       String?
  user         User?               @relation("MessaggiRicevuti", fields: [userId], references: [id], onDelete: SetNull)
  scatenante   ScatenanteMessaggio
  /// Quale dei testi del modello è uscito questa volta.
  testoId      String?
  testoUsato   TestoModello?       @relation(fields: [testoId], references: [id], onDelete: SetNull)
  /// Il testo davvero mandato, con i segnaposto già sostituiti.
  testo        String
  /// Numero o id del gruppo.
  destinazione String
  /// Come si legge: "Gruppo Zero Dark" oppure "Marco Allario".
  aChi         String
  stato        StatoMessaggio      @default(DA_MANDARE)
  esito        String?
  eventId      String?
  event        Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  /// La chiave che impedisce il doppione: "COMPLEANNO-<id>-2026".
  occasione    String
  creatoIl     DateTime            @default(now())
  inviatoIl    DateTime?

  @@unique([destinazione, occasione])
  @@index([stato])
}

// ---------------------------------------------------------------- assistenti (MCP)

/// Chiave personale con cui un assistente agisce **per conto** di una persona.
///
/// Non ha poteri suoi: vale esattamente quanto l'account di chi l'ha creata, e
/// se quei ruoli cambiano la chiave cambia potere con loro. Del token si tiene
/// solo l'impronta — chi la legge dal database non può ricostruirlo, e chi lo
/// perde ne fa un altro invece di farselo dire.
model TokenMcp {
  id          String    @id
  userId      String
  utente      User      @relation("TokenMcpDi", fields: [userId], references: [id], onDelete: Cascade)
  /// Come lo chiama chi l'ha fatta: "Claude sul portatile", "telefono".
  nome        String
  /// SHA-256 del token intero. Il token e' casuale e lungo: non serve un hash
  /// lento come per le password, che difendono da parole di senso compiuto.
  hash        String
  /// La parte iniziale, per riconoscerla nell'elenco senza svelarla.
  prefisso    String
  creatoIl    DateTime  @default(now())
  ultimoUsoIl DateTime?
  usi         Int       @default(0)
  scadeIl     DateTime?
  revocatoIl  DateTime?

  @@index([userId])
}

// ---------------------------------------------------------------- statuto e regolamenti

enum TipoDocumento {
  /// Le regole con cui il team esiste. Ce n'è uno solo.
  STATUTO
  /// Come ci si comporta. Ce ne possono essere quanti se ne scrivono.
  REGOLAMENTO
}

/// Statuto e regolamenti.
///
/// Stavano in due file Markdown nel volume, ed era la scelta giusta finché
/// erano due e basta. Da quando i regolamenti sono un elenco — uno di condotta,
/// uno del mercatino, quelli che verranno — servono titolo, ordine e una
/// cronologia di chi li ha toccati: un indice a fianco dei file sarebbe stata
/// una tabella scritta peggio.
///
/// Chi li legge non è scritto qui ma nel codice, e dipende dal tipo: lo statuto
/// è di chi è dentro, i regolamenti li legge chiunque abbia un account — sono
/// quello che si mostra a chi si sta affacciando.
model Documento {
  id             String        @id @default(cuid())
  tipo           TipoDocumento
  /// Come compare nell'indirizzo: /regolamenti/condotta
  slug           String        @unique
  titolo         String
  sottotitolo    String?
  testo          String
  ordine         Int           @default(0)
  creatoIl       DateTime      @default(now())
  aggiornatoIl   DateTime      @updatedAt
  aggiornatoDaId String?
  aggiornatoDa   User?         @relation("DocumentiScritti", fields: [aggiornatoDaId], references: [id], onDelete: SetNull)

  accettazioni AccettazioneDocumento[]

  @@index([tipo, ordine])
}

// ---------------------------------------------------------------- mercatino

enum StatoAnnuncio {
  /// Si prepara con calma: non lo vede nessuno tranne chi lo scrive.
  BOZZA
  PUBBLICATO
  /// Tolto dal giro. Non sparisce: chi ci torna deve capire che è andata.
  RITIRATO
}

enum NaturaVoce {
  /// Ce n'è uno. Venduto quello, è finita.
  PEZZO_UNICO
  /// Merchandising: non finisce, se ne ordina un altro.
  RIORDINABILE
}

enum StatoVoce {
  DISPONIBILE
  PRENOTATA
  VENDUTA
}

/// Un annuncio del mercatino: un lotto, non un oggetto.
///
/// "Vendo tutto: torcia 50, tattico 100, mesh 150" è un annuncio con una foto e
/// tre voci. Anche un oggetto solo è un lotto di uno — nessun caso speciale da
/// scrivere, nessun ramo del codice che vale solo per gli annunci semplici.
model Annuncio {
  id           String        @id @default(cuid())
  titolo       String
  descrizione  String?
  stato        StatoAnnuncio @default(BOZZA)
  /// Merchandising del team: lo crea solo l'admin, e da qui nascono le quote
  /// che finiscono in cassa. È questo bollino a decidere dove vanno i soldi,
  /// per questo non può metterselo chi vuole.
  ufficiale    Boolean       @default(false)
  venditoreId  String
  venditore    User          @relation("AnnunciDi", fields: [venditoreId], references: [id], onDelete: Cascade)
  /// La foto che si vede in bacheca, scelta da chi vende. È un riferimento e
  /// non una casella su ogni foto: così la copertina è una per costruzione.
  copertinaId  String?       @unique
  copertina    FotoAnnuncio? @relation("Copertina", fields: [copertinaId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  pubblicatoIl DateTime?
  creatoIl     DateTime      @default(now())
  aggiornatoIl DateTime      @updatedAt

  voci     VoceAnnuncio[]
  foto     FotoAnnuncio[]     @relation("FotoDi")
  commenti CommentoAnnuncio[]
  miPiace  MiPiaceAnnuncio[]

  @@index([stato, ufficiale])
}

model FotoAnnuncio {
  id          String    @id @default(cuid())
  annuncioId  String
  annuncio    Annuncio  @relation("FotoDi", fields: [annuncioId], references: [id], onDelete: Cascade)
  /// L'originale ridimensionato, e la versione piccola per le card: senza,
  /// sfogliare la bacheca dal telefono scarica venti foto intere.
  file        String
  miniatura   String
  ordine      Int       @default(0)
  copertinaDi Annuncio? @relation("Copertina")

  @@index([annuncioId, ordine])
}

/// Una riga dell'annuncio: titolo, prezzo e descrizione suoi.
model VoceAnnuncio {
  id            String             @id @default(cuid())
  annuncioId    String
  annuncio      Annuncio           @relation(fields: [annuncioId], references: [id], onDelete: Cascade)
  titolo        String
  /// Come la si nomina in un commento: @radio-m. Unica dentro il suo annuncio
  /// e non in tutto il mercatino — due persone che vendono una radio M devono
  /// poterla chiamare tutte e due così.
  maniglia      String
  prezzo        Decimal            @db.Decimal(10, 2)
  trattabile    Boolean            @default(false)
  descrizione   String?
  natura        NaturaVoce         @default(PEZZO_UNICO)
  /// Spenta: resta scritta ma non è più in vendita. Serve al merchandising —
  /// un modello che non si fa più — e all'usato, per mettere da parte una cosa
  /// senza cancellarla e perderne i commenti.
  attiva        Boolean            @default(true)
  /// Da quale scaffale esce, quando esce da uno scaffale nostro.
  ///
  /// Vuoto vuol dire che la merce non è in casa: si ordina al fornitore a ogni
  /// giro e non finisce mai, oppure è un pezzo unico dell'usato. Pieno vuol
  /// dire che c'è una giacenza che scende, e finita è finita.
  ///
  /// **È un collegamento e non una spunta**, ed è la differenza che conta: la
  /// vetrina e il magazzino sono due elenchi diversi, e questa riga dice quali
  /// righe dell'uno pescano dall'altro.
  articoloId    String?
  articolo      ArticoloMagazzino? @relation(fields: [articoloId], references: [id], onDelete: SetNull)
  /// Solo per i pezzi unici: su una maglietta "venduta" non vuol dire niente.
  stato         StatoVoce          @default(DISPONIBILE)
  prenotataDaId String?
  prenotataDa   User?              @relation("VociPrenotate", fields: [prenotataDaId], references: [id], onDelete: SetNull)
  prenotataIl   DateTime?
  ordine        Int                @default(0)

  citata   CitazioneVoce[]
  righe    RigaOrdine[]
  carrelli RigaCarrello[]

  @@unique([annuncioId, maniglia])
  @@index([annuncioId, ordine])
  @@index([articoloId])
}

/// Commento sotto un annuncio: lo legge chiunque veda l'annuncio.
model CommentoAnnuncio {
  id           String    @id @default(cuid())
  annuncioId   String
  annuncio     Annuncio  @relation(fields: [annuncioId], references: [id], onDelete: Cascade)
  userId       String
  utente       User      @relation("CommentiAnnunci", fields: [userId], references: [id], onDelete: Cascade)
  testo        String
  createdAt    DateTime  @default(now())
  modificatoIl DateTime?

  citate       CitazioneVoce[]
  segnalazioni Segnalazione[]

  @@index([annuncioId])
}

/// Quale voce nomina un commento.
///
/// Sotto un annuncio con cinque voci, "quanto per quella grande?" non vuol dire
/// niente: con la chiocciola si dice quale. Come per le note, l'elenco si
/// ricava dal testo a ogni salvataggio — il testo è la verità, questo è solo un
/// indice per ritrovarlo.
model CitazioneVoce {
  commentoId String
  commento   CommentoAnnuncio @relation(fields: [commentoId], references: [id], onDelete: Cascade)
  voceId     String
  voce       VoceAnnuncio     @relation(fields: [voceId], references: [id], onDelete: Cascade)

  @@id([commentoId, voceId])
  @@index([voceId])
}

model MiPiaceAnnuncio {
  annuncioId String
  annuncio   Annuncio @relation(fields: [annuncioId], references: [id], onDelete: Cascade)
  userId     String
  utente     User     @relation("MiPiaceAnnunci", fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([annuncioId, userId])
}

/// Le poche cose che si regolano senza toccare il codice. Una riga sola, come
/// per le credenziali federali e il ponte WhatsApp.
enum StatoSegnalazione {
  APERTA
  ACCOLTA // il messaggio è stato tolto
  RESPINTA // guardata, ma non c'era niente da togliere
}

/// Un messaggio che ha urtato qualcuno.
///
/// Chi legge una cosa fuori posto la passa a chi può occuparsene, invece di
/// rispondere a tono sotto: è l'unico modo perché una bacheca resti un posto
/// dove si ha voglia di scrivere.
///
/// Il testo si **copia qui dentro** al momento della segnalazione. Se il
/// messaggio viene cancellato — dal moderatore o da chi l'ha scritto — resta
/// scritto cosa era stato segnalato, altrimenti la segnalazione diventerebbe
/// un rimando a niente e nessuno saprebbe più se era fondata.
///
/// I due riferimenti sono due colonne vere e non una sola "cosa segnalata":
/// così è il database a controllare che puntino a qualcosa che esiste, e non
/// ci si ritrova con righe orfane che si scoprono sempre troppo tardi.
model Segnalazione {
  id                 String            @id @default(cuid())
  segnalatoreId      String
  segnalatore        User              @relation("SegnalazioniFatte", fields: [segnalatoreId], references: [id], onDelete: Cascade)
  commentoAnnuncioId String?
  commentoAnnuncio   CommentoAnnuncio? @relation(fields: [commentoAnnuncioId], references: [id], onDelete: SetNull)
  commentoEventoId   String?
  commentoEvento     CommentoEvento?   @relation(fields: [commentoEventoId], references: [id], onDelete: SetNull)
  /// Copia del messaggio com'era, e di chi l'aveva scritto.
  testo              String
  autore             String
  /// Perché è stato segnalato, se chi segnala ha voluto dirlo.
  motivo             String?
  stato              StatoSegnalazione @default(APERTA)
  gestitaDaId        String?
  gestitaDa          User?             @relation("SegnalazioniGestite", fields: [gestitaDaId], references: [id], onDelete: SetNull)
  gestitaIl          DateTime?
  createdAt          DateTime          @default(now())

  /// Una segnalazione per persona e per messaggio: il secondo clic non è una
  /// segnalazione in più, è la stessa.
  @@unique([segnalatoreId, commentoAnnuncioId])
  @@unique([segnalatoreId, commentoEventoId])
  @@index([stato])
}

/// Dove sta un riordino al fornitore.
///
/// I due passaggi sono separati perché nella realtà lo sono: si paga quando si
/// paga e la roba arriva quando arriva, a volte prima, a volte tre settimane
/// dopo. Lo stato dice fin dove si è arrivati; se i soldi sono usciti lo dice
/// la data del pagamento, non lo stato.
enum StatoRiordino {
  APERTO // scritto: niente soldi e niente merce
  PAGATO // l'uscita di cassa c'è
  RICEVUTO // la merce è entrata in magazzino
  ANNULLATO
}

/// Un ordine di riordino al fornitore: la merce che il team compra per sé.
///
/// È il contrario di un ordine del merchandising — lì la squadra compra dal
/// team, qui il team compra dal fornitore — e per questo tocca la cassa dalla
/// parte delle **uscite**, non degli incassi.
model Riordino {
  id          String          @id @default(cuid())
  /// Progressivo leggibile: "il riordino 7" si dice a voce, un cuid no.
  numero      Int             @default(autoincrement())
  fornitore   String?
  note        String?
  stato       StatoRiordino   @default(APERTO)
  creatoIl    DateTime        @default(now())
  pagatoIl    DateTime?
  ricevutoIl  DateTime?
  /// L'uscita di cassa che ne è nata. Annullando il riordino se ne va con lui:
  /// quei soldi non sono più usciti.
  movimentoId String?         @unique
  movimento   MovimentoCassa? @relation(fields: [movimentoId], references: [id], onDelete: SetNull)
  creatoDaId  String?
  creatoDa    User?           @relation("RiordiniCreati", fields: [creatoDaId], references: [id], onDelete: SetNull)

  righe RigaRiordino[]

  @@index([stato])
}

/// Una riga di riordino: quanti pezzi di cosa, e a quanto.
model RigaRiordino {
  id            String            @id @default(cuid())
  riordinoId    String
  riordino      Riordino          @relation(fields: [riordinoId], references: [id], onDelete: Cascade)
  articoloId    String
  articolo      ArticoloMagazzino @relation(fields: [articoloId], references: [id], onDelete: Restrict)
  quantita      Int
  costoUnitario Decimal           @db.Decimal(10, 2)

  /// Il carico che la ricezione ha generato: c'è solo dopo che la merce è
  /// arrivata, e serve a non ricevere due volte la stessa riga.
  carico CaricoMagazzino?

  @@index([riordinoId])
}

/// Un errore capitato **nel browser di qualcuno**, con quello che stava
/// facendo.
///
/// Il messaggio «qualcosa si è rotto» si cura ricaricando, e per chi lo vede
/// finisce lì. Per noi finiva lì anche l'informazione: nessuno sa cosa fosse
/// aperto, cosa era stato premuto, se era già successo. Un difetto che si
/// manifesta una volta al mese e non lascia traccia non si corregge — si
/// convive, e la gente smette di segnalarlo perché tanto «poi funziona».
///
/// Per questo, prima del pulsante *Ricarica*, la scheda spedisce qui quello
/// che sa: l'errore con la sua pila di chiamate, l'indirizzo, la versione del
/// gestionale, e il **diario di bordo** — le ultime cose successe con l'orario
/// accanto. È quello a dire *cosa stava facendo*, che è la domanda a cui non
/// si sapeva rispondere.
model ErroreClient {
  id        String   @id @default(cuid())
  quando    DateTime @default(now())
  /// Chi l'ha incontrato. Resta nullo se è successo prima dell'accesso.
  userId    String?
  utente    User?    @relation("ErroriIncontrati", fields: [userId], references: [id], onDelete: SetNull)
  messaggio String
  /// Il nome della classe di errore: TypeError, ChunkLoadError…
  nome      String?
  /// Il riferimento che Next mostra a chi legge la pagina rotta: è il filo che
  /// lega questa riga a quello che la persona ha letto sullo schermo.
  digest    String?
  stack     String?
  indirizzo String?
  /// Che browser e che telefono: metà dei difetti che capitano a uno solo
  /// capitano al suo browser.
  agente    String?
  /// La versione del gestionale in quel momento: senza, un errore vecchio di
  /// due settimane sembra ancora aperto.
  versione  String?
  /// Le ultime cose successe prima dello schianto, una per riga con l'ora.
  diario    String?
  /// Come si è saputo: il confine di React, un errore non catturato, una
  /// promessa rifiutata.
  origine   String?
  /// Già guardato da chi tiene il gestionale: serve a non riesaminare le
  /// stesse righe ogni volta che si apre la pagina.
  visto     Boolean  @default(false)

  @@index([quando])
  @@index([visto, quando])
}

/// Le voci di menu che una persona si è messa da parte.
///
/// Il gestionale ha una quarantina di pagine e nessuno le usa tutte: chi tiene
/// la cassa vive su tre schermate, un atleta su due, e sono tre schermate
/// diverse. I preferiti sono la risposta — **non un menu diverso per ruolo, ma
/// il proprio menu**, che ognuno si compone premendo una stellina dove gli
/// serve.
///
/// Si conserva solo l'indirizzo, non l'etichetta né l'icona: quelle si
/// ripescano ogni volta dal menu vero. Così una voce che cambia nome cambia
/// nome anche qui, e una voce che una persona non può più vedere sparisce dai
/// suoi preferiti da sola invece di restare a puntare su una porta chiusa.
model Preferito {
  userId String
  utente User   @relation("PreferitiDi", fields: [userId], references: [id], onDelete: Cascade)
  /// L'indirizzo della voce di menu: /admin/cassa, /calendario…
  href   String
  /// In che ordine li ha messi: si cambia con un pressione lunga sul menu.
  ordine Int    @default(0)

  @@id([userId, href])
  @@index([userId, ordine])
}

/// Chi ha letto e accettato un regolamento, e quale versione.
///
/// Serve dove le regole non sono un cartello ma un patto: il mercatino non si
/// apre finché non le si è lette. La **versione** è la data dell'ultima
/// modifica del testo — se il regolamento cambia si torna a chiedere, perché
/// aver accettato altro non è aver accettato questo.
model AccettazioneDocumento {
  userId      String
  utente      User      @relation("DocumentiAccettati", fields: [userId], references: [id], onDelete: Cascade)
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  accettatoIl DateTime  @default(now())
  versione    DateTime

  @@id([userId, documentoId])
  @@index([documentoId])
}

/// Una scorta comprata in blocco: quante e quanto sono costate.
///
/// Il costo non serve alla cassa — quello passa dai movimenti come sempre —
/// ma a sapere **quanto ci guadagna o ci rimette il team** su ogni pezzo: una
/// patch venduta a 5 che ne è costata 4,20 è un'altra cosa da una che ne è
/// costata 1,50, e senza scriverlo da qualche parte non se lo ricorda nessuno.
///
/// I carichi si sommano invece di aggiornare un numero solo: così resta la
/// storia dei prezzi pagati, e una quantità sbagliata si corregge togliendo la
/// riga sbagliata e non indovinando il totale giusto.
/// Un articolo di magazzino: una cosa che il team **ha in casa**.
///
/// Non è una riga del catalogo, ed è la correzione di un errore. Prima il
/// magazzino era una spunta sulla voce del merchandising, e da quella spunta
/// discendeva tutto quello che non tornava: mettere in conto un generatore lo
/// affacciava in vetrina, e toglierlo dalla vendita sembrava dire che non lo
/// si teneva più.
///
/// Sono due domande diverse, e tutt'e quattro le risposte esistono davvero:
///
/// - il **generatore**: lo tengo, non lo vendo — articolo senza voci;
/// - le **patch**: le tengo e le vendo — articolo con una voce collegata;
/// - le **magliette**: le vendo e non le tengo, si ordinano al fornitore a
///   ogni giro — voce senza articolo;
/// - una **prevendita**: la metto in vetrina prima di averla — voce senza
///   articolo oggi, collegata quando la merce arriva.
///
/// Con una spunta sola se ne potevano scrivere due su quattro. Per questo è un
/// modello suo, e il collegamento con la vetrina è facoltativo da entrambe le
/// parti.
model ArticoloMagazzino {
  id           String   @id @default(cuid())
  nome         String
  /// Come si raggruppa in elenco: "Patch", "Materiale di squadra", "Divise".
  /// Libera, perché ogni squadra tiene in casa cose diverse.
  categoria    String?
  note         String?
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  carichi  CaricoMagazzino[]
  riordini RigaRiordino[]
  /// Le righe di vetrina che pescano da qui: nessuna, se non si vende.
  voci     VoceAnnuncio[]

  @@index([categoria, nome])
}

model CaricoMagazzino {
  id             String            @id @default(cuid())
  articoloId     String
  articolo       ArticoloMagazzino @relation(fields: [articoloId], references: [id], onDelete: Cascade)
  quantita       Int
  /// Quanto è costato al team un singolo pezzo.
  costoUnitario  Decimal           @db.Decimal(10, 2)
  fornitore      String?
  note           String?
  compratoIl     DateTime          @default(now())
  /// La riga di riordino che questo carico ha ricevuto, se non è una rettifica
  /// fatta a mano. È quello che permette al registro di dire *+50 per
  /// l'ordine 7* invece di un +50 che non si sa da dove esca.
  rigaRiordinoId String?           @unique
  rigaRiordino   RigaRiordino?     @relation(fields: [rigaRiordinoId], references: [id], onDelete: SetNull)
  /// L'uscita di cassa con cui questa merce è stata comprata, quando la spesa
  /// si registra dalla cassa invece che da un riordino. Sparita la spesa
  /// sparisce il carico: se quei soldi non sono usciti, quella roba non è
  /// entrata.
  movimentoId    String?           @unique
  movimento      MovimentoCassa?   @relation(fields: [movimentoId], references: [id], onDelete: Cascade)
  registratoDaId String?
  registratoDa   User?             @relation("CarichiRegistrati", fields: [registratoDaId], references: [id], onDelete: SetNull)

  @@index([articoloId])
}

/// Il carrello di una persona, che aspetta.
///
/// Sta nel database e non nella pagina perché è **uno solo e attraversa il
/// catalogo**: si aggiunge una maglietta oggi, due patch domani, e si ordina
/// quando si è finito di girare. Un carrello che vive dentro una pagina si
/// svuota ogni volta che si cambia articolo, ed è esattamente il motivo per
/// cui non funzionava.
model RigaCarrello {
  id         String       @id @default(cuid())
  userId     String
  utente     User         @relation("CarrelloDi", fields: [userId], references: [id], onDelete: Cascade)
  voceId     String
  voce       VoceAnnuncio @relation(fields: [voceId], references: [id], onDelete: Cascade)
  quantita   Int
  aggiuntaIl DateTime     @default(now())

  /// Una riga sola per voce: aggiungerla di nuovo alza il numero, non
  /// raddoppia la riga.
  @@unique([userId, voceId])
  @@index([userId])
}

/// Vita di un ordine del merchandising, dal carrello alla consegna.
///
/// *Pagato* e *consegnato* sono due cose diverse: uno paga oggi e ritira fra
/// tre settimane, quando la fornitura arriva. Per questo lo stato dell'ordine
/// non guarda i soldi — quelli stanno sul pagamento, dove stanno tutti gli
/// altri — ma solo dove si trova la merce.
enum StatoOrdine {
  RACCOLTA // ordinato dalla squadra, si aspetta di chiudere il giro
  ORDINATO // passato al fornitore: da qui non conta più nel "quanti ne servono"
  ARRIVATO // in casa, da consegnare
  CONSEGNATO
  ANNULLATO
}

/// Un ordine del merchandising: il carrello di una persona, spedito.
///
/// Non appartiene a un articolo solo: il carrello attraversa il catalogo, e
/// una maglietta più due patch sono **un** ordine e **una** quota. A quale
/// articolo appartiene ogni riga lo dice la voce che ha dentro.
///
/// Nasce insieme alla sua quota, che compare fra i pagamenti di chi ordina e
/// in cassa come tutto il resto. È il bollino di ufficiale sull'annuncio a
/// deciderlo: una vendita privata fra due soci non passa dai soldi del
/// gestionale, e farcela passare sporcherebbe il saldo della squadra.
model Ordine {
  id           String      @id @default(cuid())
  /// Progressivo leggibile: "ordine 14" si dice a voce, un cuid no.
  numero       Int         @default(autoincrement())
  userId       String
  utente       User        @relation("OrdiniDi", fields: [userId], references: [id], onDelete: Cascade)
  stato        StatoOrdine @default(RACCOLTA)
  note         String?
  /// La quota che ne è nata. Resta staccabile: se la segreteria cancella il
  /// pagamento l'ordine non deve sparire con lui.
  paymentId    String?     @unique
  payment      Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  creatoIl     DateTime    @default(now())
  ordinatoIl   DateTime?
  arrivatoIl   DateTime?
  consegnatoIl DateTime?

  righe RigaOrdine[]

  @@index([stato])
  @@index([userId])
}

/// Una riga del carrello, con il prezzo congelato.
///
/// Titolo e prezzo sono copiati e non letti dalla voce: se la maglietta passa
/// da 25 a 28 dopo che in dieci hanno ordinato, le loro quote sono già emesse
/// a 25 e devono restare leggibili per quello che erano. È la stessa regola
/// della quota di un'attività.
model RigaOrdine {
  id       String       @id @default(cuid())
  ordineId String
  ordine   Ordine       @relation(fields: [ordineId], references: [id], onDelete: Cascade)
  voceId   String
  voce     VoceAnnuncio @relation(fields: [voceId], references: [id], onDelete: Restrict)
  titolo   String
  prezzo   Decimal      @db.Decimal(10, 2)
  quantita Int

  @@index([voceId])
}

/// Il resoconto di una giornata, scritto dopo.
///
/// Una gara finisce e resta nella testa di chi c’era: cosa ha funzionato, chi
/// stava dove, l’errore che non si ripete. Scritto, diventa la memoria della
/// squadra — e chi non c’era può leggerla.
///
/// Uno per attività: è il racconto di quel giorno, non una bacheca. I commenti
/// e i «mi piace» sono quelli dell’attività, perché si parla della stessa cosa
/// e tenere due discussioni separate sullo stesso pomeriggio non aiuta
/// nessuno.
model Debriefing {
  id           String   @id @default(cuid())
  eventId      String   @unique
  evento       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  titolo       String?
  /// Markdown, come statuto e regolamenti.
  testo        String
  /// In bozza lo vede solo chi lo scrive: un resoconto a metà non si legge.
  pubblicato   Boolean  @default(false)
  autoreId     String?
  autore       User?    @relation("DebriefingScritti", fields: [autoreId], references: [id], onDelete: SetNull)
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  letture LetturaDebriefing[]

  @@index([pubblicato])
}

/// Chi ha letto quale debriefing.
///
/// La lettura è di chi legge, non della squadra: se lo apre un altro, a te
/// resta segnalato. Stessa idea del pallino sulle attività nuove — un
/// resoconto della squadra che nessuno sa di dover leggere non lo legge
/// nessuno.
model LetturaDebriefing {
  debriefingId String
  debriefing   Debriefing @relation(fields: [debriefingId], references: [id], onDelete: Cascade)
  userId       String
  utente       User       @relation("LettoreDebriefing", fields: [userId], references: [id], onDelete: Cascade)
  lettoIl      DateTime   @default(now())

  @@id([debriefingId, userId])
  @@index([userId])
}

model Impostazioni {
  id                  String   @id @default("app")
  /// Se chi non è ancora in squadra può mettere annunci. Vedere lo può sempre.
  nuoviPossonoVendere Boolean  @default(false)
  aggiornatoIl        DateTime @updatedAt
}
