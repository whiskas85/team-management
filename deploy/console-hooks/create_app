#!/usr/bin/env bash
# Hook della console ZeroDark (repo whiskas85/team-dashboard, agent zdt-agent):
# «Nuova app» crea un gestionale ospitato con deploy/squadra-server.sh nuova.
#
# Installazione sul server (una volta; i link seguono il codice aggiornato):
#   ln -sf /opt/gestionale/deploy/console-hooks/create_app /etc/zdt-agent/hooks/create_app
#   ln -sf /opt/gestionale/deploy/console-hooks/remove_app /etc/zdt-agent/hooks/remove_app
#   ln -sf /opt/gestionale/deploy/console-hooks/purge_app /etc/zdt-agent/hooks/purge_app
#   ln -sf /opt/gestionale/deploy/console-hooks/set_admin_password /etc/zdt-agent/hooks/set_admin_password
#
# L'agent lo lancia come root, con ZDT_APP_NAME e ZDT_APP_DOMAIN (gli altri
# campi qui non servono). Uscita 0 = fatto; quello che si stampa finisce nella
# console, e l'ultima riga JSON dice alla console quali container guardare.
#
# La password dell'admin: se la console la sceglie (ZDT_APP_ADMIN_PASSWORD),
# dopo la creazione si imposta quella, e l'ultima riga lo conferma con
# "admin_password":"applied"; vuota, resta quella generata dallo script. In
# entrambi i casi **non esce da qui**: sta solo in /opt/squadra-<nome>/ACCESSO.txt.
set -euo pipefail
# i campi anche dal JSON su stdin, per le versioni dell'agent che non li
# mettono tutti nell'ambiente
. "$(dirname "$(readlink -f "$0")")/campi.sh"

nome=${ZDT_APP_NAME:?manca il nome dell app}
dominio=${ZDT_APP_DOMAIN:-$nome.zerodarkteam.it}

# Nome, dominio e duplicati li controlla squadra-server.sh: ops, test*, www e
# i nomi già usati sono rifiutati con un messaggio, e qui si esce con errore.
SQUADRA=$nome DOMINIO=$dominio NOME=$nome EMAIL=${ZDT_APP_EMAIL:-} \
  bash /opt/gestionale/deploy/squadra-server.sh nuova

if [ -n "${ZDT_APP_ADMIN_PASSWORD:-}" ]; then
  # chiesta e non applicata è un errore: il gestionale c'è, la password si
  # riprova con set_admin_password
  if ! ADMIN_PASSWORD=$ZDT_APP_ADMIN_PASSWORD \
    bash /opt/gestionale/deploy/squadra-server.sh password "$nome" "${ZDT_APP_EMAIL:-}"; then
    echo "Il gestionale $nome è stato creato, ma la password scelta non è stata applicata."
    exit 1
  fi
  echo "{\"kind\": \"docker\", \"match\": \"^zd-sq-$nome-\", \"admin_password\": \"applied\"}"
else
  echo "{\"kind\": \"docker\", \"match\": \"^zd-sq-$nome-\"}"
fi
