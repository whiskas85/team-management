#!/usr/bin/env bash
# Hook della console ZeroDark: reimposta la password di un amministratore di un
# gestionale ospitato già esistente, con deploy/squadra-server.sh password.
#
# Riceve ZDT_APP_NAME, ZDT_APP_EMAIL (vuota: l'admin di partenza creato da
# «nuova») e ZDT_APP_ADMIN_PASSWORD. Tocca un utente solo, e solo se è
# amministratore; al primo accesso gli si chiede di cambiarla. La password non
# si stampa mai: viaggia per stdin fino all'app, che la salva come sempre
# (bcrypt). Le sessioni già aperte restano valide fino alla scadenza: sono
# cookie firmati, senza un registro sul server da cui toglierle.
#
# Uscita 0 e ultima riga {"admin_password":"applied"} solo se è applicata.
# Installazione: vedi create_app.
set -euo pipefail
# i campi anche dal JSON su stdin, per le versioni dell'agent che non li
# mettono tutti nell'ambiente
. "$(dirname "$(readlink -f "$0")")/campi.sh"

nome=${ZDT_APP_NAME:?manca il nome dell app}
[ -n "${ZDT_APP_ADMIN_PASSWORD:-}" ] || { echo "Manca la password."; exit 1; }

ADMIN_PASSWORD=$ZDT_APP_ADMIN_PASSWORD CAMBIA=1 \
  bash /opt/gestionale/deploy/squadra-server.sh password "$nome" "${ZDT_APP_EMAIL:-}"

echo '{"admin_password":"applied"}'
