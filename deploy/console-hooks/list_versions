#!/usr/bin/env bash
# Hook del portale ZeroDark: le versioni pronte su questo server e, se si
# indica un'app (ZDT_APP_NAME), quella che sta usando. Una riga JSON:
#   {"available":["3.25.0","3.24.0"],"latest":"3.25.0","current":"3.24.0"}
# Installazione: vedi create_app.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/campi.sh"

bash /opt/gestionale/deploy/squadra-server.sh versioni "${ZDT_APP_NAME:-}"
