# Copia questo file in .env e personalizza i valori.

# --- database (usato da docker-compose) ---
POSTGRES_USER=zerodark
POSTGRES_PASSWORD=zerodark
POSTGRES_DB=zerodark

# --- app ---
APP_PORT=3000
# Fuso orario dell'applicazione: gli orari degli eventi seguono questo.
TZ=Europe/Rome
# Chiave di firma dei cookie di sessione: cambiala, minimo 32 caratteri.
SESSION_SECRET=cambia-questa-chiave-in-produzione-almeno-32-char
# 0 per uso in LAN via http, 1 quando davanti c'è HTTPS (dominio pubblico).
COOKIE_SECURE=0
# 1 = pulsanti di accesso rapido per figura nella pagina di login e account di
# prova creati dal seed. Tienilo a 0 quando il gestionale è in uso reale.
DEBUG_LOGIN=1

# --- account admin creato al primo avvio ---
SEED_ADMIN_EMAIL=admin@zerodark.team
SEED_ADMIN_PASSWORD=ZeroDark2026!

# --- solo per sviluppo locale senza Docker (npm run dev) ---
DATABASE_URL=postgresql://zerodark:zerodark@localhost:5432/zerodark?schema=public
UPLOAD_DIR=./uploads
