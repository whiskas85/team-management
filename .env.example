# Copia questo file in .env e personalizza i valori.

# --- database (usato da docker-compose) ---
POSTGRES_USER=zerodark
POSTGRES_PASSWORD=zerodark
POSTGRES_DB=zerodark

# --- app ---
APP_PORT=3000
# Fuso orario dell'applicazione: gli orari degli eventi seguono questo.
TZ=Europe/Rome
# Chiave di firma dei cookie di sessione: cambiala, minimo 32 caratteri.
SESSION_SECRET=cambia-questa-chiave-in-produzione-almeno-32-char
# 0 per uso in LAN via http, 1 quando davanti c'è HTTPS (dominio pubblico).
COOKIE_SECURE=0
# 1 = pulsanti di accesso rapido per figura nella pagina di login e account di
# prova creati dal seed. Tienilo a 0 quando il gestionale è in uso reale.
DEBUG_LOGIN=1

# --- account admin creato al primo avvio ---
SEED_ADMIN_EMAIL=admin@zerodark.team
SEED_ADMIN_PASSWORD=ZeroDark2026!

# --- solo per sviluppo locale senza Docker (npm run dev) ---
DATABASE_URL=postgresql://zerodark:zerodark@localhost:5432/zerodark?schema=public
UPLOAD_DIR=./uploads

# --- HTTPS (proxy davanti all'app) ---
# Genera il certificato con certificati/genera.sh, poi metti COOKIE_SECURE=1.
HTTPS_PORT=443
HTTP_PORT=80
# Con il proxy davanti, l'app in chiaro si lega solo alla macchina stessa.
BIND_APP=127.0.0.1
# Suffisso della porta https nei rimandi: vuoto se usi la 443.
SUFFISSO_HTTPS=

# --- ponte WhatsApp ---
# Segreto condiviso fra gestionale e ponte: generane uno tuo.
SEGRETO_WHATSAPP=cambia-questo-segreto

# --- notifiche push ---
# Coppia di chiavi VAPID, una per ambiente: si generano con
#   npx web-push generate-vapid-keys --json
# Senza, il gestionale non propone nemmeno di attivarle.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:qualcuno@tuodominio.it

# --- solo sul server pubblico (.env.prod, docker-compose.prod.yml) ---
# Il nome a cui risponde il gestionale e l'indirizzo per gli avvisi di
# Let's Encrypt. Tutto il giro è spiegato in deploy/DEPLOY.md.
DOMINIO=gestionale.tuodominio.it
EMAIL_CERTIFICATI=
